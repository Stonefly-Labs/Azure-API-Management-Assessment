<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'">
<title>APIM assessment - Iteration {{ iteration }}</title>
<script>
  (() => {
    const param = new URLSearchParams(window.location.search).get("scoutTheme");
    const theme =
      param || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    document.documentElement.setAttribute("data-theme", theme);
  })();
</script>
<style>
:root {
  color-scheme: light;
  --cp-bg: #f7f4ef;
  --cp-bg-elevated: #fcfbf8;
  --cp-surface: #ffffff;
  --cp-surface-soft: #f5f5f5;
  --cp-border: #dedede;
  --cp-border-strong: #919191;
  --cp-text: #242424;
  --cp-text-muted: #5c5c5c;
  --cp-text-soft: #6f6f6f;
  --cp-accent: #b11f4b;
  --cp-accent-hover: #9a1a41;
  --cp-accent-soft: rgba(177, 31, 75, 0.08);
  --cp-accent-fg: #ffffff;
  --cp-success: #16a34a;
  --cp-danger: #dc2626;
  --cp-warning: #f59e0b;
  --cp-link: #0078d4;
  --cp-shadow: 0 18px 48px rgba(0, 0, 0, 0.12);
  --cp-overlay: rgba(255, 255, 255, 0.8);
  --cp-panel: rgba(255, 255, 255, 0.86);
  --cp-panel-strong: rgba(255, 255, 255, 0.96);
  --cp-sheen: rgba(255, 255, 255, 0.55);
  --cp-highlight: rgba(177, 31, 75, 0.12);
}
html[data-theme="dark"] {
  color-scheme: dark;
  --cp-bg: #3d3b3a;
  --cp-bg-elevated: #343231;
  --cp-surface: #292929;
  --cp-surface-soft: #2e2e2e;
  --cp-border: #474747;
  --cp-border-strong: #5f5f5f;
  --cp-text: #dedede;
  --cp-text-muted: #919191;
  --cp-text-soft: #b0b0b0;
  --cp-accent: #fd8ea1;
  --cp-accent-hover: #fb7b91;
  --cp-accent-soft: rgba(253, 142, 161, 0.14);
  --cp-accent-fg: #1a1a1a;
  --cp-success: #4ade80;
  --cp-danger: #f87171;
  --cp-warning: #fbbf24;
  --cp-link: #4da6ff;
  --cp-shadow: 0 18px 48px rgba(0, 0, 0, 0.32);
  --cp-overlay: rgba(41, 41, 41, 0.88);
  --cp-panel: rgba(41, 41, 41, 0.72);
  --cp-panel-strong: rgba(41, 41, 41, 0.96);
  --cp-sheen: rgba(255, 255, 255, 0.04);
  --cp-highlight: rgba(253, 142, 161, 0.12);
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--cp-bg); color: var(--cp-text); font: 16px/1.5 "Segoe UI", Aptos, Calibri, -apple-system, BlinkMacSystemFont, sans-serif; }
header, footer { padding: 16px 32px; background: var(--cp-bg-elevated); border-bottom: 1px solid var(--cp-border); display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
header { position: sticky; top: 0; z-index: 1; }
header strong { margin-right: auto; }
main { max-width: 1440px; margin: auto; padding: 32px; }
.slide { min-height: 65vh; }
.eyebrow { color: var(--cp-accent); text-transform: uppercase; letter-spacing: 0.12em; font-weight: 600; }
h1 { font-size: clamp(2rem, 5vw, 4rem); line-height: 1.1; max-width: 1000px; }
h2 { font-size: 2rem; }
h3 { margin-top: 0; }
.muted, small { color: var(--cp-text-muted); }
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; }
.card, article, .notice { padding: 24px; border: 1px solid var(--cp-border); background: var(--cp-surface); border-radius: 16px; margin-bottom: 16px; }
.score { font-size: 2.5rem; color: var(--cp-accent); }
.notice { border-left: 4px solid var(--cp-warning); }
button, select, input { font: inherit; background: var(--cp-surface); color: var(--cp-text); border: 1px solid var(--cp-border-strong); border-radius: 0.625rem; padding: 8px 12px; max-width: 100%; }
button { cursor: pointer; }
button:hover { background: var(--cp-accent-soft); }
button:focus-visible, select:focus-visible, input:focus-visible, summary:focus-visible, a:focus-visible { outline: 2px solid var(--cp-accent); outline-offset: 4px; }
button:disabled { cursor: default; color: var(--cp-text-muted); }
a { color: var(--cp-link); overflow-wrap: anywhere; }
code { font-family: Consolas, "Courier New", Courier, monospace; overflow-wrap: anywhere; }
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; margin: 16px 0; }
th, td { padding: 12px; border-bottom: 1px solid var(--cp-border); text-align: left; vertical-align: top; }
th { color: var(--cp-text-muted); }
.pass { color: var(--cp-success); }
.fail { color: var(--cp-danger); }
.unknown, .unsupported { color: var(--cp-text-muted); }
.warning { color: var(--cp-warning); }
.filters { display: flex; flex-wrap: wrap; gap: 16px; padding: 16px 0; align-items: end; }
.filters label { display: grid; gap: 4px; flex: 1 1 180px; }
.filters input { width: 100%; }
summary { cursor: pointer; overflow-wrap: anywhere; }
.finding h3 { margin: 8px 0; }
.finding details > div { padding-top: 16px; }
body[data-mode="slides"] .explorer-filters, body[data-mode="slides"] #explorer-nav { display: none; }
body[data-mode="explorer"] footer { display: none; }
#explorer-nav { padding: 16px 32px; display: flex; gap: 8px; flex-wrap: wrap; }
button[aria-pressed="true"] { border-color: var(--cp-accent); background: var(--cp-accent-soft); }
.badge { font-weight: 700; text-transform: uppercase; }
svg { width: 100%; max-width: 600px; height: auto; color: var(--cp-text); }
.node { fill: var(--cp-surface-soft); stroke: var(--cp-border-strong); }
.edge { stroke: var(--cp-accent); stroke-width: 2; }
svg text { fill: var(--cp-text); font-size: 15px; }
[hidden] { display: none !important; }
footer { justify-content: center; border-top: 1px solid var(--cp-border); }
@media print {
  header, footer, #explorer-nav, .explorer-filters { display: none !important; }
  main { padding: 0; }
  .scope:not([hidden]) .slide[hidden] { display: block !important; }
  .slide { break-before: page; min-height: 0; }
  article { break-inside: avoid; }
}
</style>
</head>
<body data-mode="slides">
<header>
  <strong>apim-assess / assessment</strong>
  <label for="scope-select">Scope</label>
  <select id="scope-select">
    {% for scope in scopes %}<option value="{{ loop.index0 }}">{{ scope.title }}</option>{% endfor %}
  </select>
  <button id="mode" type="button" aria-pressed="false">Deep-dive explorer</button>
  <button id="theme" type="button">Toggle theme</button>
  <button id="fullscreen" type="button">Fullscreen</button>
</header>
<nav id="explorer-nav" aria-label="Explorer views">
  <button type="button" data-panel="findings" aria-pressed="true">Findings</button>
  <button type="button" data-panel="policy" aria-pressed="false">Effective policies</button>
  <button type="button" data-panel="mcsb" aria-pressed="false">MCSB coverage</button>
  {% if iteration == "5" %}
  <button type="button" data-panel="modern" aria-pressed="false">Upstream &amp; AI gateway</button>
  <button type="button" data-panel="roadmap" aria-pressed="false">Remediation roadmap</button>
  {% endif %}
</nav>
<main>
{% for scope in scopes %}
<div class="scope" id="scope-{{ loop.index0 }}">
  <section class="slide">
    <p class="eyebrow">Iteration {{ iteration }} / assessment scope</p>
    <h1>API Management<br>{{ scope.title }} readout</h1>
    <p>{{ scope.instances | length }} instance(s) / collected {{ snapshot.collected_at.isoformat() }}</p>
    <p class="muted">Telemetry: {{ snapshot.telemetry_start.isoformat() }} to {{ snapshot.telemetry_end.isoformat() }} (UTC)</p>
    <div class="notice">{% if legacy %}Legacy findings: five service rules, no policy assessment.
      {% elif iteration == "2" %}Five service rules and six policy rules.
      Historical policy interpretations are preserved; rerun analyze to apply current checks.
      {% else %}Core APIM five-pillar catalog; {{ scope.findings | length }} rule results in this scope.{% endif %} Not a complete MCSB compliance assessment.
      Unknown and unsupported signals are never treated as passes. Policy results assess configuration,
      not runtime enforcement. {% if iteration in ["4", "5"] %}Linked network/governance metadata and optional
      aggregate gateway logs are included when available. {% else %}Adjacent-network analysis remains outside
      this historical assessment. {% endif %}{% if iteration == "5" %}Optional upstream WAF
      probes and recognized LLM/GraphQL checks are included with explicit evidence limits.
      {% else %}Upstream WAF and AI gateway analysis remain outside scope.{% endif %}</div>
    {% for instance in scope.instances %}
    <article>
      <h3>{{ instance.name }}</h3>
      <code>{{ instance.resource_id }}</code>
      <p>{{ instance.environment }} ({{ instance.environment_source }}); core collection: {{ instance.core_status }}</p>
    </article>
    {% endfor %}
    <h3>Collection warnings</h3>
    {% for warning in snapshot.collection_warnings %}
      {% if scope.portfolio or warning.resource_id == scope.instances[0].resource_id or warning.module == "discovery" %}
      <p><strong>{{ warning.module }} / {{ warning.code }}</strong>: {{ warning.message }} <code>{{ warning.resource_id }}</code></p>
      {% endif %}
    {% else %}<p>No collection warnings recorded.</p>{% endfor %}
  </section>
  <section class="slide">
    <p class="eyebrow">Executive scorecard / {{ scope.title }}</p>
    <h2>Health of the assessed controls</h2>
    <div class="cards">
      {% for score in scope.scores %}
      <div class="card">
        <h3>{{ score.pillar }}</h3>
        <div class="score">{{ score.score if score.score is not none else "N/A" }}</div>
        <p>{{ score.passed }} pass / {{ score.failed }} fail<br>{{ score.unknown }} unknown<br>{{ score.unsupported }} unsupported / {{ score.not_applicable }} not applicable<br>{{ score.waived }} waived (excluded)</p>
        {% if score.score is none %}<small>Not assessed; not a healthy score.</small>{% endif %}
      </div>
      {% endfor %}
    </div>
    <p>Scores use severity-weighted passes divided by known pass/fail results only.
      Critical=5, High=4, Medium=3, Low=2, Advisory=1. Portfolio scores weight individual
      results, not instance averages. Coverage counts above must accompany every score.</p>
    <p class="muted">Each rule contributes once per instance, not once per operation.
      The policy matrix shows context coverage separately. Waivers retain original outcomes and evidence but are excluded from scores.</p>
    {% if iteration in ["3", "4", "5"] %}
    <div class="card">
      <h3>MCSB assessed-mapping rate</h3>
      <div class="score">{{ scope.mcsb_score if scope.mcsb_score is not none else "N/A" }}</div>
      <p>Percentage of known pass/fail control-instance mappings passing. Warning, unsupported, waived and
        not-applicable mappings are excluded, never passes. See the MCSB coverage matrix for the denominator.
        This is not a complete benchmark compliance score or certification.</p>
    </div>
    {% endif %}
  </section>
  <section class="slide" data-panel="policy">
    <p class="eyebrow">Effective policy coverage / {{ scope.title }}</p>
    <h2>API &amp; operation execution contexts</h2>
    <p>Product policies are evaluated separately from non-product subscription and no-subscription requests.
      The first effective CORS policy is used. Conditional, unavailable and unsupported evidence stays unknown.</p>
    <p class="muted">Present = configured control satisfies the check; absent = check not satisfied.
      Backend means backend-entity routing; CORS means the wildcard-origin check.
      This does not verify token claims, reachability, browser behavior or runtime enforcement.</p>
    {% for instance in scope.instances %}
    <article>
      <h3>{{ instance.name }}</h3>
      {% if instance.inventory %}
      <details><summary>Sub-resource collection coverage</summary>
      {% for path, coverage in instance.inventory.collections.items() %}
        <p><code>{{ path }}</code>: {{ coverage.status }} / {{ coverage.count }} observed</p>
      {% endfor %}
      </details>
      {% else %}<p>Sub-resource inventory was not collected. Policy coverage is unknown.</p>{% endif %}
    </article>
    {% endfor %}
    <div class="table-wrap">
      <table>
        <thead><tr><th>APIM / API / operation</th><th>Context</th><th>Inheritance</th><th>Caller authentication</th><th>JWT / Entra</th><th>Rate / concurrency</th><th>CORS</th><th>Backend entity</th></tr></thead>
        <tbody>
        {% for row in scope.policy_coverage %}
        <tr>
          <td><code>{{ row.resource_id }}</code><br><code>{{ row.operation_path or row.api_path }}</code>
            {% if row.http_gateway_only %}<p>API type omitted: HTTP(S) gateway policies only; resolver-specific policies not assessed.</p>{% endif %}
            {% for issue in row.issues %}<p>{{ issue }}</p>{% endfor %}</td>
          <td>{{ row.product_path or "Non-product" }}<br>
            {% if row.subscription_required is sameas true %}Subscription context
            {% elif row.subscription_required is sameas false %}No subscription required
            {% else %}Subscription requirement unknown{% endif %}
          </td>
          <td>{{ row.inheritance }}</td><td>{{ row.authentication }}</td><td>{{ row.jwt }}</td>
          <td>{{ row.rate_limit }}</td><td>{{ row.cors }}</td><td>{{ row.backend }}</td>
        </tr>
        {% else %}<tr><td colspan="8">No collected API contexts. Check inventory coverage before interpreting this as an empty service.</td></tr>{% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  <section class="slide" data-panel="mcsb">
    <p class="eyebrow">MCSB mapped coverage / {{ scope.title }}</p>
    <h2>Partial evidence, explicit gaps</h2>
    <p>Microsoft flags the APIM MCSB v1 baseline as potentially outdated. Current APIM documentation governs
      feature decisions. Mappings cover only the implemented configuration checks, not whole controls.</p>
    <p>A control-instance row fails if any unwaived mapped check fails, warns for unavailable,
      unsupported or waived evidence, and passes only when every applicable unwaived mapped check passes.
      A row contributes once, regardless of how many rules map to it.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>APIM / control</th><th>Status</th><th>Pass / fail</th><th>Unknown / unsupported / waived / N/A</th><th>Mapped rules</th></tr></thead>
        <tbody>
        {% for row in scope.mcsb_coverage %}
        <tr><td><code>{{ row.resource_id }}</code><br>{{ row.control }}</td>
          <td class="{{ row.status }}">{{ row.status }}</td><td>{{ row.passed }} / {{ row.failed }}</td>
          <td>{{ row.unknown }} / {{ row.unsupported }} / {{ row.waived }} / {{ row.not_applicable }}</td>
          <td>{{ row.rule_ids | join(", ") }}</td></tr>
        {% else %}<tr><td colspan="5">No stored MCSB coverage for this artifact version; not a compliance pass.</td></tr>{% endfor %}
        </tbody>
      </table>
    </div>
    <p class="muted">Unimplemented controls{% if iteration != "5" %}, including upstream WAF,{% endif %} are outside this catalog,
      not silently passed or included in the denominator.</p>
  </section>
  <section class="slide">
    <p class="eyebrow">Topology &amp; metrics / {{ scope.title }}</p>
    <h2>Collected gateway configuration</h2>
    {% for instance in scope.instances %}
    <article>
      <h3>{{ instance.name }}</h3>
      <svg viewBox="0 0 600 90" role="img" aria-label="Logical gateway topology, not verified reachability">
        <rect class="node" x="4" y="12" width="160" height="64" rx="10"></rect>
        <text x="20" y="49">Clients</text>
        <line class="edge" x1="164" y1="44" x2="220" y2="44"></line>
        <rect class="node" x="220" y="12" width="370" height="64" rx="10"></rect>
        <text x="236" y="49">APIM / {{ instance.sku.name if instance.sku else "uncollected SKU" }}</text>
      </svg>
      <p>Primary region: {{ instance.location or "Not collected" }} /
        Units: {{ instance.sku.capacity if instance.sku and instance.sku.capacity is not none else "Not collected" }} /
        Zones: {{ instance.zones if instance.zones is not none else "Not collected" }}</p>
      <p>Additional locations: {{ instance.additional_locations if instance.additional_locations is not none else "Not collected" }}</p>
      <p>VNet mode: {{ instance.virtual_network_type or "Not collected" }} /
        Public network access: {{ instance.public_network_access or "Not collected" }} /
        Private endpoint states: {{ instance.private_endpoint_statuses if instance.private_endpoint_statuses is not none else "Not collected" }}</p>
      <p class="muted">Logical configuration only. Linked NSG metadata is not proof of WAF, routing or runtime reachability.</p>
      {% if iteration in ["4", "5"] %}
      <h3>Adjacent signal coverage</h3>
      <p>Networking: {{ instance.networking.status if instance.networking else "not collected" }} /
        Injected subnets: {{ instance.networking.subnets_status if instance.networking else "not collected" }} /
        Log Analytics: {{ instance.log_analytics.status if instance.log_analytics else "not collected" }}</p>
      {% if instance.networking %}
      {% for endpoint in instance.networking.private_endpoints %}
      <p>Private endpoint {{ endpoint.reference }}: {{ endpoint.status }} / approved={{ endpoint.approved }} / subnet linkage={{ endpoint.subnet_linked }}.</p>
      {% endfor %}
      {% for address in instance.networking.public_ips %}
      <p>Public IP {{ address.reference }}: {{ address.status }} / DDoS mode={{ address.ddos_mode if address.ddos_mode else "unknown" }} / inherited VNet protection={{ address.vnet_ddos_enabled }}.</p>
      {% endfor %}
      <p class="muted">Only explicitly linked public IP resources are probed. No link is not evidence that DDoS protection is absent.</p>
      {% endif %}
      {% if instance.governance %}
      <p>Resource diagnostics: {{ instance.governance.diagnostics_status }} /
        Autoscale: {{ instance.governance.autoscale_status }} /
        Defender: {{ instance.governance.defender_status }} /
        Policy states: {{ instance.governance.policy_status }}</p>
      {% endif %}
      {% if instance.log_analytics %}
      {% for workspace in instance.log_analytics.workspaces %}
      <p>Log sample {{ workspace.workspace }} / {{ workspace.table }}: {{ workspace.status }}.</p>
      {% if workspace.aggregate %}
      <p>Logged requests={{ workspace.aggregate.requests }} /
        TLS-known={{ workspace.aggregate.tls_known }}, legacy TLS={{ workspace.aggregate.weak_tls }} /
        Gateway 5xx={{ workspace.aggregate.gateway_5xx }}, backend 5xx={{ workspace.aggregate.backend_5xx }} /
        Backend p95={{ workspace.aggregate.backend_p95_ms if workspace.aggregate.backend_p95_ms is not none else "unknown" }} ms /
        Cache hits={{ workspace.aggregate.cache_hits }}, misses={{ workspace.aggregate.cache_misses }}.
        {% set cache_total = workspace.aggregate.cache_hits + workspace.aggregate.cache_misses %}
        Cache hit ratio={{ "%.1f%%" | format(100 * workspace.aggregate.cache_hits / cache_total) if cache_total else "not observed" }}.</p>
      {% endif %}
      {% endfor %}
      {% endif %}
      <p class="muted">Log counts describe recorded samples, not all callers. Workspaces/tables are not added together.
        Raw callers, URLs, request/response bodies, headers and log rows are not saved.</p>
      {% endif %}
      <div class="table-wrap">
      <table>
        <thead><tr><th>Metric / region</th><th>Status</th><th>Samples</th><th>Mean hourly average</th><th>Peak maximum</th><th>Total</th></tr></thead>
        <tbody>
        {% for metric in metric_summary(instance) %}
        <tr><td>{{ metric.name }} / {{ metric.location }} ({{ metric.unit }})</td><td>{{ metric.status }}</td><td>{{ metric.samples }}</td><td>{{ metric.average }}</td><td>{{ metric.maximum }}</td><td>{{ metric.total }}</td></tr>
        {% else %}<tr><td colspan="6">No telemetry collected.</td></tr>{% endfor %}
        </tbody>
      </table>
      </div>
    </article>
    {% endfor %}
  </section>
  {% if iteration == "5" %}
  <section class="slide" data-panel="modern">
    <p class="eyebrow">Upstream WAF &amp; AI gateway / {{ scope.title }}</p>
    <h2>Matched paths, explicit evidence limits</h2>
    <p>Upstream matching uses observed gateway hostnames/IPs in the authorized scope, not DNS traversal.
      A WAF attachment alone is not origin lockdown. HTTPS forwarding, bot/rate controls and probes
      are configuration observations, not live traffic tests.</p>
    {% for instance in scope.instances %}
    <article>
      <h3>{{ instance.name }}</h3>
      {% if instance.upstream %}
      {% for provider, probe in [("Front Door", instance.upstream.afd), ("Application Gateway", instance.upstream.appgw)] %}
      <h4>{{ provider }}: {{ probe.status }} / {{ probe.candidates }} candidate(s)</h4>
      {% for route in probe.routes %}
      <details>
        <summary>Matched route <code>{{ route.reference }}</code></summary>
        <p>Source network restriction: {{ route.network_restricted }} /
          HTTPS-only: {{ route.https_only }} / explicit HTTPS probe: {{ route.health_probe }}.</p>
        {% if route.waf %}
        <p>WAF enabled: {{ route.waf.enabled }} / Prevention: {{ route.waf.prevention }} /
          blocking managed rules: {{ route.waf.managed_rules }} /
          bot rules: {{ route.waf.bot_protection }} / rate-limit rule: {{ route.waf.rate_limiting }}.</p>
        {% else %}<p>WAF metadata unavailable; protection is not established.</p>{% endif %}
      </details>
      {% else %}<p>No matched route observed; this does not prove WAF absence.</p>{% endfor %}
      {% endfor %}
      {% else %}<p>Upstream probes were not collected.</p>{% endif %}
    </article>
    {% endfor %}
    <h3>Modern workload control observations</h3>
    <p>Endpoint classification is heuristic and secret-free. Unknown custom endpoints are not assumed
      to be Azure OpenAI; managed identity is not prescribed for third-party LLM providers.
      No model prompts/responses or inference calls are collected.</p>
    {% for finding in scope.findings if finding.rule.id.startswith("APIM-AIGW-") %}
    <details class="card">
      <summary>{{ finding.rule.id }} / {{ finding.result.outcome }} / {{ finding.severity }} /
        <code>{{ finding.resource_id }}</code></summary>
      {% if finding.waiver_justification %}<p>Waived: {{ finding.waiver_justification }}</p>{% endif %}
      <p>{{ finding.result.summary }}</p>
      {% for evidence in finding.result.evidence %}<p>{{ evidence.detail }}</p>{% endfor %}
    </details>
    {% endfor %}
  </section>
  <section class="slide" data-panel="roadmap">
    <p class="eyebrow">Prioritized remediation / {{ scope.title }}</p>
    <h2>30 / 60 / 90-day planning roadmap</h2>
    <p>Deterministic severity-first planning buckets, not delivery commitments or effort estimates.
      Validate business risk, dependencies and change windows with owners. Only unwaived failures
      appear below; unknown/unsupported coverage still needs investigation in the explorer.</p>
    {% for title, items in roadmap(scope.findings) %}
    <article>
      <h3>{{ title }}</h3>
      {% for finding in items %}
      <details>
        <summary>{{ finding.severity }} / {{ finding.rule.id }} / {{ finding.rule.title }} /
          <code>{{ finding.resource_id }}</code></summary>
        <p>{{ finding.rule.business_impact }}</p>
        <p>{{ finding.rule.remediation }}</p>
      </details>
      {% else %}<p>No unwaived confirmed failures in this planning bucket.</p>{% endfor %}
    </article>
    {% endfor %}
    {% if scope.portfolio %}
    <article>
      <h3>Optional AI executive commentary</h3>
      <p>Aggregate-only portfolio commentary is unverified synthesis, not assessment evidence.
        Findings, applicability, severity, waivers and scores remain deterministic and unchanged.</p>
      {% if narrative and narrative.status == "complete" %}
      <p>{{ narrative.text }}</p>
      {% elif narrative %}<p>Enrichment unavailable: {{ narrative.error_code }}. No generated text was retained.</p>
      {% else %}<p>Not requested. This report and roadmap require no AI service.</p>{% endif %}
    </article>
    {% endif %}
  </section>
  {% endif %}
  <section class="slide findings-panel" data-panel="findings">
    <p class="eyebrow">Rule results / {{ scope.title }}</p>
    <h2>Evidence &amp; remediation</h2>
    <div class="explorer-filters">
      <div class="filters">
        <label>Search<input class="filter-search" type="search" placeholder="Rule, resource, evidence or remediation" aria-label="Search findings"></label>
        <label>Pillar<select class="filter-pillar"><option value="">All pillars</option>{% for pillar in ["REL", "SEC", "COST", "OPS", "PERF"] %}<option>{{ pillar }}</option>{% endfor %}</select></label>
        <label>Severity<select class="filter-severity"><option value="">All severities</option>{% for severity in ["Critical", "High", "Medium", "Low", "Advisory"] %}<option>{{ severity }}</option>{% endfor %}</select></label>
        <label>MCSB control<select class="filter-control"><option value="">All controls</option>{% for control in scope.controls %}<option>{{ control }}</option>{% endfor %}</select></label>
        <label>Affected API<select class="filter-api"><option value="">All APIs / service-wide</option>{% for api in scope.apis %}<option>{{ api }}</option>{% endfor %}</select></label>
        <label>Outcome<select class="filter-outcome"><option value="">All outcomes</option>{% for outcome in ["fail", "pass", "unknown", "unsupported", "not_applicable", "waived"] %}<option>{{ outcome }}</option>{% endfor %}</select></label>
        <button type="button" class="reset-filters">Reset filters</button>
      </div>
      <p class="filter-count" role="status" aria-live="polite"></p>
      <p class="filter-empty" hidden>No findings match these filters. Hidden results do not change scores or assessment coverage.</p>
    </div>
    {% for finding in scope.findings %}
    <article class="finding" data-pillar="{{ finding.rule.pillar }}" data-severity="{{ finding.severity }}"
      data-controls="{{ finding.rule.mcsb_controls | join(' ') }}" data-apis="{{ finding_apis(finding) | join('\n') }}"
      data-outcome="{{ 'waived' if finding.waiver_justification is not none else finding.result.outcome }}">
      <details>
      <summary>
      <span class="badge {{ finding.result.outcome }}">{{ finding.result.outcome }}</span> / {{ finding.severity }} / {{ finding.rule.pillar }} / {{ finding.rule.id }}<br>
      <strong>{{ finding.rule.title }}</strong><br>
      <code>{{ finding.resource_id }}</code>
      </summary>
      <div>
      {% if finding.waiver_justification is not none %}<p class="notice"><strong>Waived (excluded from scores):</strong> {{ finding.waiver_justification }}. Original outcome and evidence retained.</p>{% endif %}
      <p>{{ finding.result.summary }}</p>
      {% for evidence in finding.result.evidence %}<p><strong>{{ evidence.source }}</strong>: {{ evidence.detail }}</p>{% endfor %}
      <p><strong>Business impact:</strong> {{ finding.rule.business_impact }}</p>
      <p><strong>Remediation:</strong> {{ finding.rule.remediation }}</p>
      <p><strong>Applicability:</strong> {{ finding.rule.applicability }}</p>
      {% if finding.rule.mcsb_controls %}<p>MCSB mapping (partial configuration evidence): {{ finding.rule.mcsb_controls | join(", ") }}</p>{% endif %}
      {% for reference in finding.rule.references %}<p><a href="{{ reference }}" rel="noreferrer">{{ reference }}</a></p>{% endfor %}
      </div>
      </details>
    </article>
    {% else %}<p>No rule results.</p>{% endfor %}
    {% if iteration in ["3", "4", "5"] %}
    <details><summary>Saved assessment thresholds</summary>
      {% for name, value in rule_settings.thresholds.model_dump().items() %}<p><code>{{ name }}</code>: {{ value }}</p>{% endfor %}
      <p>Severity overrides take precedence over profile defaults. Resource-scoped waivers take precedence over global waivers.</p>
    </details>
    {% endif %}
  </section>
</div>
{% endfor %}
</main>
<footer>
  <button id="previous" type="button">Previous</button>
  <span id="position" aria-live="polite"></span>
  <button id="next" type="button">Next</button>
  <small>Arrow keys / Space to navigate. F for fullscreen.</small>
  <span id="status" role="status"></span>
</footer>
<script>
(() => {
  const scopes = [...document.querySelectorAll(".scope")];
  const select = document.getElementById("scope-select");
  const pageCount = scopes[0].querySelectorAll(".slide").length;
  let page = 0;
  let explorer = false;
  let panel = "findings";
  function filter(scope) {
    const search = scope.querySelector(".filter-search").value.trim().toLowerCase();
    const pillar = scope.querySelector(".filter-pillar").value;
    const severity = scope.querySelector(".filter-severity").value;
    const control = scope.querySelector(".filter-control").value;
    const api = scope.querySelector(".filter-api").value;
    const outcome = scope.querySelector(".filter-outcome").value;
    const findings = [...scope.querySelectorAll(".finding")];
    let visible = 0;
    findings.forEach(finding => {
      finding.hidden = explorer && !(
        (!search || finding.textContent.toLowerCase().includes(search)) &&
        (!pillar || finding.dataset.pillar === pillar) &&
        (!severity || finding.dataset.severity === severity) &&
        (!control || finding.dataset.controls.split(" ").includes(control)) &&
        (!api || finding.dataset.apis.split("\n").includes(api)) &&
        (!outcome || finding.dataset.outcome === outcome)
      );
      if (!finding.hidden) visible++;
    });
    scope.querySelector(".filter-count").textContent = `${visible} of ${findings.length} findings shown. Scores include all unwaived assessed results.`;
    scope.querySelector(".filter-empty").hidden = visible !== 0;
  }
  function show() {
    document.body.dataset.mode = explorer ? "explorer" : "slides";
    document.getElementById("mode").textContent = explorer ? "Presentation mode" : "Deep-dive explorer";
    document.getElementById("mode").setAttribute("aria-pressed", String(explorer));
    document.querySelectorAll("#explorer-nav button").forEach(button => {
      button.setAttribute("aria-pressed", String(button.dataset.panel === panel));
    });
    scopes.forEach((scope, index) => {
      scope.hidden = index !== Number(select.value);
      scope.querySelectorAll(".slide").forEach((slide, position) => {
        slide.hidden = explorer ? slide.dataset.panel !== panel : position !== page;
      });
      filter(scope);
    });
    document.getElementById("position").textContent = `Slide ${page + 1} of ${pageCount}`;
    document.getElementById("previous").disabled = page === 0;
    document.getElementById("next").disabled = page === pageCount - 1;
  }
  function move(delta) { page = Math.max(0, Math.min(pageCount - 1, page + delta)); show(); window.scrollTo(0, 0); }
  async function fullscreen() {
    try {
      if (document.fullscreenElement) await document.exitFullscreen();
      else await document.documentElement.requestFullscreen();
    } catch {
      document.getElementById("status").textContent = "Fullscreen is unavailable in this browser.";
    }
  }
  select.addEventListener("change", () => { page = 0; show(); });
  document.getElementById("mode").addEventListener("click", () => { explorer = !explorer; show(); });
  document.querySelectorAll("#explorer-nav button").forEach(button => {
    button.addEventListener("click", () => { panel = button.dataset.panel; show(); });
  });
  scopes.forEach(scope => {
    scope.querySelectorAll(".filters input, .filters select").forEach(input => {
      input.addEventListener("input", () => filter(scope));
      input.addEventListener("change", () => filter(scope));
    });
    scope.querySelector(".reset-filters").addEventListener("click", () => {
      scope.querySelectorAll(".filters input, .filters select").forEach(input => { input.value = ""; });
      filter(scope);
    });
  });
  document.getElementById("previous").addEventListener("click", () => move(-1));
  document.getElementById("next").addEventListener("click", () => move(1));
  document.getElementById("fullscreen").addEventListener("click", fullscreen);
  document.getElementById("theme").addEventListener("click", () => {
    document.documentElement.dataset.theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
  });
  document.addEventListener("keydown", event => {
    if (event.altKey || event.ctrlKey || event.metaKey || event.target.closest("select,input,button,textarea,summary,a,[contenteditable=true]")) return;
    if (!explorer && (event.key === "ArrowRight" || event.key === " ")) { event.preventDefault(); move(1); }
    if (!explorer && event.key === "ArrowLeft") { event.preventDefault(); move(-1); }
    if (event.key.toLowerCase() === "f") fullscreen();
  });
  show();
})();
</script>
</body>
</html>
